# Copia este archivo como .env y completa valores propios. No publiques .env.
ADMIN_USER=administrador
ADMIN_PASSWORD=cambia-esta-contrasena-por-una-segura
JWT_SECRET=crea-una-clave-larga-aleatoria-de-al-menos-32-caracteres
PORT=3000
# Hosting Render + Supabase. Si DATABASE_URL está definido, el backend usa PostgreSQL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=il-salone-media
# Resend: correo transaccional. Usa un remitente verificado en tu cuenta.
RESEND_API_KEY=
BIRTHDAY_EMAIL_FROM=
# WhatsApp Cloud API de Meta. El nombre/idioma deben coincidir con una plantilla aprobada.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BIRTHDAY_TEMPLATE_NAME=birthday_promotion
WHATSAPP_BIRTHDAY_TEMPLATE_LANGUAGE=es
WHATSAPP_GRAPH_API_VERSION=v23.0
# Para ejecutar npm run cumpleanos en local:
BIRTHDAY_SITE_URL=http://localhost:3000
BIRTHDAY_CRON_SECRET=
# En local, SQLite se crea automáticamente como database.db.
# No compartas este archivo ni publiques credenciales del servicio.
